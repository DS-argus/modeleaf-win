{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modeleaf.local/schemas/w02/evidence-record.schema.json",
  "title": "Modeleaf W02 hard-gate evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "recordId", "recordType", "recordedAt", "machine", "app",
    "fixture", "sourceHashes", "result", "details", "artifactRefs"
  ],
  "properties": {
    "schemaVersion": { "const": "modeleaf.w02.evidence.v1" },
    "recordId": { "type": "string", "pattern": "^w02-[a-z0-9-]+$" },
    "recordType": {
      "enum": ["transport", "geometry", "resource", "capability", "outline", "print"]
    },
    "recordedAt": { "type": "string", "format": "date-time" },
    "machine": { "$ref": "#/$defs/machine" },
    "app": { "$ref": "#/$defs/app" },
    "fixture": { "$ref": "#/$defs/fixture" },
    "sourceHashes": { "$ref": "#/$defs/sourceHashes" },
    "result": { "enum": ["pass", "fail"] },
    "details": { "type": "object" },
    "artifactRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifactRef" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "recordType": { "const": "transport" } } },
      "then": { "properties": { "details": { "$ref": "#/$defs/transportDetails" } } }
    },
    {
      "if": { "properties": { "recordType": { "const": "geometry" } } },
      "then": { "properties": { "details": { "$ref": "#/$defs/geometryDetails" } } }
    },
    {
      "if": { "properties": { "recordType": { "const": "resource" } } },
      "then": { "properties": { "details": { "$ref": "#/$defs/resourceDetails" } } }
    },
    {
      "if": { "properties": { "recordType": { "const": "capability" } } },
      "then": { "properties": { "details": { "$ref": "#/$defs/capabilityDetails" } } }
    },
    {
      "if": { "properties": { "recordType": { "const": "outline" } } },
      "then": { "properties": { "details": { "$ref": "#/$defs/outlineDetails" } } }
    },
    {
      "if": { "properties": { "recordType": { "const": "print" } } },
      "then": { "properties": { "details": { "$ref": "#/$defs/printDetails" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "os", "build", "arch", "cpu", "ramBytes", "gpu", "webview2"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "build": { "type": "string", "minLength": 1 },
        "arch": { "const": "x64" },
        "cpu": { "type": "string", "minLength": 1 },
        "ramBytes": { "type": "integer", "minimum": 1 },
        "gpu": { "type": "string", "minLength": 1 },
        "webview2": { "type": "string", "minLength": 1 }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "version", "commit", "dirty", "buildProfile", "sourceTreeSha256",
        "binarySha256", "pdfjsVersion"
      ],
      "properties": {
        "name": { "const": "Modeleaf" },
        "version": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "dirty": { "type": "boolean" },
        "buildProfile": { "enum": ["debug", "release"] },
        "sourceTreeSha256": { "$ref": "#/$defs/sha256" },
        "binarySha256": { "$ref": "#/$defs/sha256" },
        "pdfjsVersion": { "const": "6.2.108" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "bytes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.pdf$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "sourceHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": { "$ref": "#/$defs/sha256" },
        "after": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "pattern": "^artifacts/[A-Za-z0-9_-]+\\.json$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "transportDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headStatus", "fullGetStatus", "rangeStatus", "initialRange", "probeBodyBytes", "maxAcceptedRangeBytes", "firstRejectedRangeBytes", "probeContentLength",
        "rangeBeforeComplete", "invalidRangeStatus", "multiRangeStatus", "eofRangeStatus",
        "overflowRangeStatus", "overLimitRangeStatus", "wrongOwnerStatus", "staleGenerationStatus",
        "closingStatus", "capacityStatus", "ioFailureStatus", "cancellationCovered", "sourceUnchanged"
      ],
      "properties": {
        "headStatus": { "const": 200 },
        "fullGetStatus": { "const": 200 },
        "rangeStatus": { "const": 206 },
        "initialRange": { "const": "bytes=0-1048575" },
        "probeBodyBytes": { "const": 1048576 },
        "probeContentLength": { "const": 1048576 },
        "maxAcceptedRangeBytes": { "const": 4194304 },
        "firstRejectedRangeBytes": { "const": 4194305 },
        "rangeBeforeComplete": { "const": true },
        "invalidRangeStatus": { "const": 416 },
        "multiRangeStatus": { "const": 416 },
        "eofRangeStatus": { "const": 416 },
        "overflowRangeStatus": { "const": 416 },
        "overLimitRangeStatus": { "const": 416 },
        "wrongOwnerStatus": { "const": 404 },
        "staleGenerationStatus": { "const": 404 },
        "closingStatus": { "const": 404 },
        "capacityStatus": { "const": 503 },
        "ioFailureStatus": { "const": 500 },
        "cancellationCovered": { "const": true },
        "sourceUnchanged": { "const": true }
      }
    },
    "geometryDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "thresholdCssPx", "allLinksInsideFrame", "allTextSpansInsideFrame"],
      "properties": {
        "cases": {
          "type": "array", "minItems": 16, "maxItems": 16, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["dpr", "rotation", "maxLayerEdgeDeltaCssPx"],
            "properties": {
              "dpr": { "enum": [1, 1.25, 1.5, 2] },
              "rotation": { "enum": [0, 90, 180, 270] },
              "maxLayerEdgeDeltaCssPx": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "thresholdCssPx": { "const": 1 },
        "allLinksInsideFrame": { "const": true },
        "allTextSpansInsideFrame": { "const": true }
      }
    },
    "resourceDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text10ColdMs", "text10WarmMs", "text300ColdMs", "text300WarmMs", "navigationMs",
        "idleMs", "maximumMountedCanvases", "maximumActiveRenderTasks", "maximumResidentDistanceFromActivePage",
        "residentWindowInvariantCovered", "unmountedRenderCancelled", "longTasksOver100Ms",
        "workingSetStartBytes", "workingSetPeakBytes", "workingSetPostIdleBytes", "declinedFromPeak",
        "cancelledBackingReleased"
      ],
      "properties": {
        "text10ColdMs": { "type": "number", "minimum": 0, "maximum": 1500 },
        "text10WarmMs": { "type": "number", "minimum": 0, "maximum": 1500 },
        "text300ColdMs": { "type": "number", "minimum": 0, "maximum": 2500 },
        "text300WarmMs": { "type": "number", "minimum": 0, "maximum": 2500 },
        "navigationMs": { "type": "number", "minimum": 59000 },
        "idleMs": { "type": "number", "minimum": 10000 },
        "maximumMountedCanvases": { "type": "integer", "minimum": 1, "maximum": 5 },
        "maximumActiveRenderTasks": { "const": 1 },
        "maximumResidentDistanceFromActivePage": { "type": "integer", "minimum": 0, "maximum": 2 },
        "residentWindowInvariantCovered": { "const": true },
        "unmountedRenderCancelled": { "const": true },
        "longTasksOver100Ms": { "const": 0 },
        "workingSetStartBytes": { "type": "integer", "minimum": 1 },
        "workingSetPeakBytes": { "type": "integer", "minimum": 1 },
        "workingSetPostIdleBytes": { "type": "integer", "minimum": 1 },
        "declinedFromPeak": { "const": true },
        "cancelledBackingReleased": { "const": true }
      }
    },
    "capabilityDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localWorkerObserved", "allSupportAssetsBundled", "externalNetworkResources",
        "interactiveFormsSuppressed", "interactiveMediaSuppressed", "pdfScriptsExecuted",
        "imageOnlyOcrObserved", "malformedHealthyDocumentPreserved", "lockedCancelDiagnostic"
      ],
      "properties": {
        "localWorkerObserved": { "const": true },
        "allSupportAssetsBundled": { "const": true },
        "externalNetworkResources": { "const": 0 },
        "interactiveFormsSuppressed": { "const": true },
        "interactiveMediaSuppressed": { "const": true },
        "pdfScriptsExecuted": { "const": false },
        "imageOnlyOcrObserved": { "const": false },
        "malformedHealthyDocumentPreserved": { "const": true },
        "lockedCancelDiagnostic": { "const": "Opening PDF cancelled." }
      }
    },
    "outlineDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rowCount", "nullStableEmpty", "emptyStableEmpty", "nestedDepth", "duplicateClassified",
        "invalidClassified", "cycleFailsClosed", "edgeRawY", "edgeClampedY"
      ],
      "properties": {
        "rowCount": { "const": 10 },
        "nullStableEmpty": { "const": true },
        "emptyStableEmpty": { "const": true },
        "nestedDepth": { "type": "integer", "minimum": 3 },
        "duplicateClassified": { "const": true },
        "invalidClassified": { "const": true },
        "cycleFailsClosed": { "const": true },
        "edgeRawY": { "const": 679 },
        "edgeClampedY": { "type": "number", "minimum": 676.29, "maximum": 676.31 }
      }
    },
    "printDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nativeDialogOpened", "pageCount", "trustedCancel", "surfaceRemoved", "objectUrlsRevoked",
        "backingReleased", "duplicateRejected", "renderAbortCovered", "errorCleanupCovered",
        "readerStatePreserved", "sourceUnchanged"
      ],
      "properties": {
        "nativeDialogOpened": { "const": true },
        "pageCount": { "const": 3 },
        "trustedCancel": { "const": true },
        "surfaceRemoved": { "const": true },
        "objectUrlsRevoked": { "const": true },
        "backingReleased": { "const": true },
        "duplicateRejected": { "const": true },
        "renderAbortCovered": { "const": true },
        "errorCleanupCovered": { "const": true },
        "readerStatePreserved": { "const": true },
        "sourceUnchanged": { "const": true }
      }
    }
  }
}
