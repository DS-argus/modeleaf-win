{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modeleaf",
  "version": "0.1.1",
  "identifier": "com.dsargus.modeleaf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Modeleaf",
        "width": 1040,
        "height": 760,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": false,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--force-renderer-accessibility"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: blob: data:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://modeleaf-pdf.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "DS-argus",
    "copyright": "Copyright (c) 2026 DS-argus",
    "category": "Productivity",
    "shortDescription": "Keyboard-first read-only PDF reader",
    "longDescription": "Modeleaf is a keyboard-first, read-only PDF reader for Windows. It never modifies source PDFs.",
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "description": "Portable Document Format",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Modeleaf"
      }
    }
  }
}
