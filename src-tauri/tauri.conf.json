{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modeleaf",
  "version": "0.1.0",
  "identifier": "com.dsargus.modeleaf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Modeleaf",
        "width": 1040,
        "height": 760,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": false,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--force-renderer-accessibility"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: blob: data:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://modeleaf-pdf.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "nsis"
  }
}
