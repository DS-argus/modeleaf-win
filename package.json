{
  "name": "modeleaf-win",
  "version": "0.1.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "assets:sync": "node tools/pdfjs/sync-assets.mjs",
    "fixtures:generate-adversarial": "node tools/fixtures/generate-adversarial-pdfs.mjs",
    "fixtures:generate-golden": "node tools/fixtures/generate-golden-pdfs.mjs",
    "fixtures:verify-golden": "vitest run tests/contract/goldenFixtures.test.ts tests/contract/goldenSnapshots.test.ts",
    "legal:verify": "node tools/legal/verify-third-party.mjs",
    "security:verify": "npm audit --omit=dev --audit-level=high",
    "tauri:build-debug": "node tools/tauri/build-debug.mjs",
    "gate:w01": "npm run legal:verify && npm run security:verify && npm run test && npm run build && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml && npm run tauri:build-debug",
    "fixtures:verify-korean": "node tools/fixtures/verify-korean-pdfs.mjs",
    "predev": "npm run assets:sync",
    "dev": "vite",
    "build": "npm run assets:sync && tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretauri": "npm run assets:sync",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "pdfjs-dist": "6.2.108",
    "smol-toml": "1.8.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
